1 ICON "phemio.ico"

// The application manifest (RT_MANIFEST = 24).
1 24 "phemio.manifest"

1 VERSIONINFO
FILEVERSION 0,38,0,0
PRODUCTVERSION 0,38,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
