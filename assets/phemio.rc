    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Minh Nguyen"
            VALUE "FileDescription", "Phemio - Your desktop cameo"
            VALUE "FileVersion", "0.38.0"
            VALUE "InternalName", "Phemio"
            VALUE "LegalCopyright", "Copyright (C) 2026 Minh Nguyen"
            VALUE "OriginalFilename", "Phemio.exe"
            VALUE "ProductName", "Phemio"
            VALUE "ProductVersion", "0.38.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
